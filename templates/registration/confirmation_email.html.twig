<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Confirm your email</title>
    </head>

    <body style="margin: 0; padding: 0; background-color: #0c4028; font-family: Arial, Helvetica, sans-serif; color: #0c4028;">

        <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width: 100%; background-color: #0c4028; margin: 0; padding: 40px 16px;"
        >
            <tr>
                <td align="center">

                    <!-- MAIN CONTAINER -->
                    <table
                        role="presentation"
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="max-width: 560px; width: 100%;"
                    >

                        <!-- HEADER -->
                        <tr>
                            <td align="center" style="padding: 20px 20px 36px;">

                                <div
                                    style="
                                color: #f2b542;
                                font-size: 11px;
                                font-weight: 600;
                                letter-spacing: 3px;
                                text-transform: uppercase;
                                margin-bottom: 16px;
                            "
                                >
                                    MINI SOLEIL
                                </div>

                                <h1
                                    style="
                                margin: 0;
                                color: #f6f0e7;
                                font-family: Georgia, 'Times New Roman', serif;
                                font-size: 42px;
                                line-height: 1.15;
                                font-weight: normal;
                            "
                                >
                                    Confirm your
                                    <span
                                        style="
                                    color: #f2b542;
                                    font-style: italic;
                                "
                                    >email</span>
                                </h1>

                                <p
                                    style="
                                margin: 16px auto 0;
                                max-width: 400px;
                                color: rgba(246, 240, 231, 0.7);
                                font-size: 14px;
                                line-height: 1.7;
                            "
                                >
                                    One quick step and your Mini Soleil account will be ready to go.
                                </p>

                            </td>
                        </tr>

                        <!-- CARD -->
                        <tr>
                            <td
                                style="
                            background-color: #f3e7d5;
                            border-radius: 16px;
                            padding: 40px 32px;
                        "
                            >

                                <!-- SECTION TITLE -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="margin-bottom: 30px;"
                                >
                                    <tr>
                                        <td width="14" style="width: 14px;">
                                            <div
                                                style="
                                            width: 8px;
                                            height: 8px;
                                            background-color: #f2b542;
                                            transform: rotate(45deg);
                                        "
                                            ></div>
                                        </td>

                                        <td
                                            style="
                                        padding-left: 8px;
                                        padding-right: 12px;
                                        white-space: nowrap;
                                    "
                                        >
                                            <span
                                                style="
                                            font-size: 11px;
                                            font-weight: 600;
                                            letter-spacing: 2px;
                                            text-transform: uppercase;
                                            color: #0c4028;
                                        "
                                            >
                                                Email verification
                                            </span>
                                        </td>

                                        <td style="width: 100%;">
                                            <div
                                                style="
                                            height: 1px;
                                            background-color: rgba(12, 64, 40, 0.1);
                                            width: 100%;
                                        "
                                            ></div>
                                        </td>
                                    </tr>
                                </table>

                                <!-- MESSAGE -->
                                <p
                                    style="
                                margin: 0 0 28px;
                                color: rgba(12, 64, 40, 0.75);
                                font-size: 15px;
                                line-height: 1.8;
                            "
                                >
                                    Thank you for creating your Mini Soleil account.
                                    Please confirm your email address by clicking the button below.
                                </p>

                                <!-- BUTTON -->
                                <table
                                    role="presentation"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    width="100%"
                                    style="margin-bottom: 30px;"
                                >
                                    <tr>
                                        <td align="center">

                                            <a
                                                href="{{ signedUrl|raw }}"
                                                style="
                                                display: inline-block;
                                                width: 100%;
                                                box-sizing: border-box;
                                                background-color: #d87527;
                                                color: #f6f0e7;
                                                text-decoration: none;
                                                font-size: 14px;
                                                font-weight: 600;
                                                letter-spacing: 0.5px;
                                                padding: 15px 24px;
                                                border-radius: 999px;
                                           "
                                            >
                                                Confirm my email
                                            </a>

                                        </td>
                                    </tr>
                                </table>

                                <!-- EXPIRATION -->
                                <p
                                    style="
                                margin: 0 0 28px;
                                text-align: center;
                                color: rgba(12, 64, 40, 0.55);
                                font-size: 13px;
                                line-height: 1.6;
                            "
                                >
                                    This link will expire in
                                    {{ expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle') }}.
                                </p>

                                <!-- FALLBACK LINK -->
                                <div
                                    style="
                                border-top: 1px solid rgba(12, 64, 40, 0.1);
                                padding-top: 24px;
                            "
                                >

                                    <p
                                        style="
                                    margin: 0 0 10px;
                                    color: rgba(12, 64, 40, 0.65);
                                    font-size: 12px;
                                    line-height: 1.6;
                                "
                                    >
                                        Button not working? Copy and paste this link into your browser:
                                    </p>

                                    <div
                                        style="
                                    background-color: #f6f0e7;
                                    border-radius: 8px;
                                    padding: 12px 14px;
                                    overflow-wrap: anywhere;
                                    word-break: break-word;
                                "
                                    >
                                        <a
                                            href="{{ signedUrl|raw }}"
                                            style="
                                            color: #0c4028;
                                            font-size: 12px;
                                            line-height: 1.6;
                                            text-decoration: underline;
                                       "
                                        >
                                            {{ signedUrl|raw }}
                                        </a>
                                    </div>

                                </div>

                                <!-- SECURITY NOTE -->
                                <p
                                    style="
                                margin: 24px 0 0;
                                color: rgba(12, 64, 40, 0.5);
                                font-size: 12px;
                                line-height: 1.7;
                            "
                                >
                                    If you didn't create a Mini Soleil account, you can safely ignore this email.
                                </p>

                            </td>
                        </tr>

                        <!-- FOOTER -->
                        <tr>
                            <td align="center" style="padding: 28px 20px 10px;">

                                <p
                                    style="
                                margin: 0;
                                color: rgba(246, 240, 231, 0.55);
                                font-size: 11px;
                                letter-spacing: 1.5px;
                                text-transform: uppercase;
                            "
                                >
                                    Mini Soleil Agency
                                </p>

                            </td>
                        </tr>

                    </table>

                </td>
            </tr>
        </table>

    </body>
</html>

